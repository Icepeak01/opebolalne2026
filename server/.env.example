# server/.env.example
# Copy this file to server/.env and fill in your real values.
# NEVER commit server/.env — it contains private credentials.

# Port the API listens on (optional; defaults to 8080)
PORT=8080

# ── Google Cloud service account ────────────────────────────────
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
# Paste the full private key on one line, keeping the literal \n sequences:
# GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GCS_PRIVATE_KEY=
GCS_BUCKET_NAME=

# ── Google Sheets ───────────────────────────────────────────────
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SONGS_TAB_NAME=Songs
GOOGLE_SHEETS_MEDIA_TAB_NAME=Media
